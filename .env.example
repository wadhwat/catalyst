# Copy to .env and fill in values
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Supermemory — inspection reports stored here when configured
SUPERMEMORY_API_KEY=
SUPERMEMORY_BASE_URL=
SUPERMEMORY_WORKSPACE=
JWT_SECRET=dev-secret
JWT_EXPIRE_MINUTES=60
CATALYST_DB_PATH=data/catalyst.db

# Inspection inference — EC2 GPU service (YOLO + Qwen). Set to your instance IP:9000.
INFERENCE_SERVICE_URL=http://your-ec2-ip:9000
INFERENCE_TIMEOUT_SEC=60
INFERENCE_CONCURRENCY_LIMIT=5

# Parts inventory for GPT part recommendations
# CSV: cat_parts_catalog.csv (default) or PARTS_CSV_PATH
# JSON: data/parts.json or PARTS_JSON_PATH
PARTS_CSV_PATH=cat_parts_catalog.csv

# ElevenLabs TTS — voice feedback for "start video" / "stop video" (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
