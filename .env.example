# Copy to .env and fill in values
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
SUPERMEMORY_API_KEY=your_api_key
SUPERMEMORY_BASE_URL=
SUPERMEMORY_WORKSPACE=
JWT_SECRET=dev-secret
JWT_EXPIRE_MINUTES=60
CATALYST_DB_PATH=data/catalyst.db

# Inspection inference — EC2 GPU service (YOLO + Qwen). Set to your instance IP:9000.
INFERENCE_SERVICE_URL=http://your-ec2-ip:9000
INFERENCE_TIMEOUT_SEC=60
INFERENCE_CONCURRENCY_LIMIT=5
